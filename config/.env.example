# Cloudflare Worker Configuration
# Copy this file to .env and fill in your values

# Cloudflare Account Details
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# D1 Database
D1_DATABASE_ID=your-database-id
D1_DATABASE_NAME=likes-and-comments

# Worker Configuration
WORKER_NAME=likes-and-comments-worker

# CORS Configuration
# Allowed origins for the worker API (comma-separated)
# Use "*" to allow all origins (not recommended for production)
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Optional: Different origins for different environments
ALLOWED_ORIGINS_PROD=https://example.com,https://www.example.com
ALLOWED_ORIGINS_STAGING=https://staging.example.com,http://localhost:3000

# Client Configuration
# These are the URLs your frontend will use
LIKES_ENDPOINT=https://likes-and-comments-worker.example.workers.dev/likes
COMMENTS_ENDPOINT=https://likes-and-comments-worker.example.workers.dev/comments

# Admin Dashboard
# Generate/rotate with: thread-cf admin-key
# Set this as a Worker secret with: wrangler secret put ADMIN_API_KEY
ADMIN_API_KEY=replace-with-a-long-random-admin-key
# Empty means never expires. Use an ISO timestamp such as 2026-12-31T23:59:59.000Z.
ADMIN_API_KEY_EXPIRES_AT=
# Dashboard session lifetime in seconds. Defaults to 3600; allowed range is 900-3600.
ADMIN_SESSION_TTL_SECONDS=3600
