# urthreads Worker Configuration
# Copy this file to .env and fill in your values

# Cloudflare Account Details
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token

# D1 Database
D1_DATABASE_ID=your-database-id
D1_DATABASE_NAME=your-threads

# Worker Configuration
WORKER_NAME=urthreads-worker
# Fill this in after deploying, or set it with: urthreads env set WORKER_URL https://your-worker.workers.dev
WORKER_URL=

# CORS Configuration
# Allowed origins for the worker API (comma-separated)
# Defaults are localhost-only. Add your deployed site or dashboard origin before production use.
# Use exact origins in production. Avoid "*" because dashboard cookie sessions require a specific origin.
ALLOWED_ORIGINS=http://localhost:8000,http://[::1]:8000

# Optional: Different origins for different environments
ALLOWED_ORIGINS_PROD=http://localhost:8000,http://[::1]:8000
ALLOWED_ORIGINS_STAGING=http://localhost:3000,http://localhost:8000,http://[::1]:8000,http://localhost:8787

# Client Configuration
# These are generated from WORKER_URL when it is set.
LIKES_ENDPOINT=
COMMENTS_ENDPOINT=

# Admin Dashboard
# Generate/rotate with: urthreads admin-key
# Set this as a Worker secret with: wrangler secret put ADMIN_API_KEY
ADMIN_API_KEY=replace-with-a-long-random-admin-key
# Empty means never expires. Use an ISO timestamp such as 2026-12-31T23:59:59.000Z.
ADMIN_API_KEY_EXPIRES_AT=
# Dashboard session lifetime in seconds. Defaults to 3600; allowed range is 900-3600.
ADMIN_SESSION_TTL_SECONDS=3600
# Optional: local static site output root and dashboard route directory.
# Set with: urthreads dashboard set ./public urthreads
DASHBOARD_LOCAL_PATH=
DASHBOARD_ENDPOINT=urthreads

# Optional runtime settings
MAX_COMMENTS_PER_POST=100
