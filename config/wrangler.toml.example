name = "urthreads-worker"
main = "src/worker.js"
compatibility_date = "2026-05-20"
account_id = "your-account-id"
workers_dev = true

[env.production]
name = "urthreads-worker-prod"

[env.staging]
name = "urthreads-worker-staging"

[[d1_databases]]
binding = "DB"
database_name = "your-threads"
database_id = "your-d1-database-id"

[[env.production.d1_databases]]
binding = "DB"
database_name = "your-threads"
database_id = "your-d1-database-id"  # Reuse the default D1 ID unless you create a separate production database.

[[env.staging.d1_databases]]
binding = "DB"
database_name = "your-threads"
database_id = "your-d1-database-id"  # Reuse the default D1 ID unless you create a separate staging database.

[vars]
ALLOWED_ORIGINS = "http://localhost:8000,http://[::1]:8000"
WORKER_NAME = "urthreads-worker"
WORKER_URL = ""
D1_DATABASE_NAME = "your-threads"
# Optional: ISO timestamp. Empty means the admin key never expires.
ADMIN_API_KEY_EXPIRES_AT = ""
# Optional: dashboard admin session TTL in seconds. Allowed range is 900-3600.
ADMIN_SESSION_TTL_SECONDS = "3600"
# Optional: "Lax" | "Strict" | "None" (default: automatic Lax/None based on origin).
# The Worker's CSRF origin check makes SameSite=None cross-origin safe.
ADMIN_SESSION_COOKIE_SAMESITE = ""
MAX_COMMENTS_PER_POST = "100"
# Optional: 32-byte base64 key for email encryption at rest. Generate with: openssl rand -base64 32
# DATA_ENCRYPTION_KEY = ""

[env.production.vars]
# IMPORTANT: Set this to your actual production site URL(s).
# Do NOT use localhost origins in production.
ALLOWED_ORIGINS = "https://your-production-site.example.com"
WORKER_NAME = "urthreads-worker-prod"
WORKER_URL = ""
D1_DATABASE_NAME = "your-threads"
ADMIN_API_KEY_EXPIRES_AT = ""
ADMIN_SESSION_TTL_SECONDS = "3600"
# Optional: "Lax" | "Strict" | "None" (default: automatic Lax/None based on origin).
# The Worker's CSRF origin check makes SameSite=None cross-origin safe.
ADMIN_SESSION_COOKIE_SAMESITE = ""
MAX_COMMENTS_PER_POST = "100"

[env.staging.vars]
ALLOWED_ORIGINS = "http://localhost:3000,http://localhost:8000,http://[::1]:8000,http://localhost:8787"
WORKER_NAME = "urthreads-worker-staging"
WORKER_URL = ""
D1_DATABASE_NAME = "your-threads"
ADMIN_API_KEY_EXPIRES_AT = ""
ADMIN_SESSION_TTL_SECONDS = "3600"
# Optional: "Lax" | "Strict" | "None" (default: automatic Lax/None based on origin).
# The Worker's CSRF origin check makes SameSite=None cross-origin safe.
ADMIN_SESSION_COOKIE_SAMESITE = ""
MAX_COMMENTS_PER_POST = "100"
