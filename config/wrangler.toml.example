name = "likes-and-comments-worker"
type = "service"
account_id = "your-account-id"
workers_dev = true

[env.production]
name = "likes-and-comments-worker-prod"

[env.staging]
name = "likes-and-comments-worker-staging"

[[d1_databases]]
binding = "DB"
database_name = "likes-and-comments"
database_id = "00000000-0000-0000-0000-000000000000"  # Replace with your D1 ID

[[env.production.d1_databases]]
binding = "DB"
database_name = "likes-and-comments-prod"
database_id = "00000000-0000-0000-0000-000000000000"  # Replace with production D1 ID

[env.staging.d1_databases]
binding = "DB"
database_name = "likes-and-comments-staging"
database_id = "00000000-0000-0000-0000-000000000000"  # Replace with staging D1 ID

[vars]
ALLOWED_ORIGINS = "https://example.com"

[env.production.vars]
ALLOWED_ORIGINS = "https://example.com"

[env.staging.vars]
ALLOWED_ORIGINS = "https://staging.example.com,http://localhost:3000"

[build]
command = "npm install"
cwd = "./"

[build.upload]
format = "modules"
main = "./src/worker.js"
