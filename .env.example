# urthreads environment template
# Copy this file to .env and replace the placeholder values.
# Never commit a real .env file.

# Cloudflare account credentials
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# D1 database
D1_DATABASE_NAME=your-threads
D1_DATABASE_ID=your-d1-database-id

# Worker deployment
WORKER_NAME=urthreads-worker
WORKER_URL=https://urthreads-worker.your-subdomain.workers.dev

# CORS
# Use exact origins in production. Avoid "*" because dashboard cookie sessions require a specific origin.
ALLOWED_ORIGINS=https://example.com,https://www.example.com
ALLOWED_ORIGINS_STAGING=https://staging.example.com,http://localhost:3000,http://localhost:8787
ALLOWED_ORIGINS_PROD=https://example.com,https://www.example.com

# Client endpoint URLs
LIKES_ENDPOINT=https://urthreads-worker.your-subdomain.workers.dev/likes
COMMENTS_ENDPOINT=https://urthreads-worker.your-subdomain.workers.dev/comments

# Admin dashboard
# Generate/rotate with: urthreads admin-key
# Set this as a Worker secret with: wrangler secret put ADMIN_API_KEY
ADMIN_API_KEY=replace-with-a-long-random-admin-key
# Empty means never expires. Use an ISO timestamp such as 2026-12-31T23:59:59.000Z.
ADMIN_API_KEY_EXPIRES_AT=
# Dashboard session lifetime in seconds. Defaults to 3600; allowed range is 900-3600.
ADMIN_SESSION_TTL_SECONDS=3600

# Optional runtime settings
MAX_COMMENTS_PER_POST=100
